{
  "rules": {
    ".read": false,
    ".write": false,
    "analytics": {
      "vistas": {
        "$productId": {
          "count": {
            ".read": true,
            ".write": "!data.exists() || newData.val() == data.val() + 1",
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
          }
        }
      },
      "whatsapp": {
        "$productId": {
          "count": {
            ".read": true,
            ".write": "!data.exists() || newData.val() == data.val() + 1",
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
          }
        }
      },
      "busquedas": {
        "$termino": {
          ".read": true,
          ".write": "!data.exists() || newData.val() == data.val() + 1",
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000"
        }
      },
      "visitas": {
        "count": {
          ".read": true,
          ".write": "!data.exists() || newData.val() == data.val() + 1",
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000"
        },
        "dias": {
          "$dia": {
            ".read": true,
            ".write": "!data.exists() || newData.val() == data.val() + 1",
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
          }
        }
      },
      ".read": true,
      ".write": false
    },
    "almacenes": {
      ".read": true,
      ".write": false,
      "$almId": {
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['nombre'])",
        "nombre": {
          ".write": "newData.exists()",
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length < 200"
        },
        "direccion": {
          ".write": "newData.exists()",
          ".validate": "newData.isString() && newData.val().length < 300"
        },
        "ubicacion": {
          ".write": "newData.exists()",
          ".validate": "newData.isString() && newData.val().length < 500"
        },
        "productos": {
          "$prodId": {
            ".write": true,
            ".validate": "newData.isBoolean()"
          }
        }
      }
    },
    "tokens": {
      "$tokenId": {
        ".write": "!data.exists() || !newData.exists() || newData.child('token').val() === data.child('token').val()",
        ".validate": "newData.hasChildren(['token', 'timestamp']) && newData.child('timestamp').val() >= now - 900000 && newData.child('timestamp').val() <= now + 900000",
        "token": {
          ".validate": "newData.isString() && newData.val().length > 50 && newData.val().length < 500"
        },
        "timestamp": {
          ".validate": "newData.isNumber()"
        },
        "userAgent": {
          ".validate": "newData.isString()"
        },
        "fingerprint": {
          ".validate": "newData.isString()"
        },
        "deviceId": {
          ".validate": "newData.isString()"
        }
      },
      ".read": "auth != null && auth.uid === root.child('admin_uid').val()",
      ".write": false
    },
    "errores_js": {
      ".read": true,
      ".write": false,
      "$errId": {
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['mensaje','pagina','ts']) && newData.child('mensaje').isString() && newData.child('mensaje').val().length > 0 && newData.child('mensaje').val().length <= 300 && newData.child('pagina').isString() && newData.child('pagina').val().length <= 200 && newData.child('ts').isNumber() && newData.child('ts').val() >= now - 300000 && newData.child('ts').val() <= now + 60000",
        "mensaje": {
          ".validate": "newData.isString() && newData.val().length <= 300"
        },
        "pagina": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "ts": {
          ".validate": "newData.isNumber()"
        },
        "ua": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "stack": {
          ".validate": "newData.isString() && newData.val().length <= 500"
        }
      }
    },
    "web_vitals": {
      ".read": true,
      ".write": false,
      "$dia": {
        "$muestraId": {
          ".write": "!data.exists()",
          ".validate": "newData.hasChildren(['lcp','cls','inp','ttfb','ts']) && newData.child('ts').val() == now",
          "lcp": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 120000"
          },
          "cls": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20"
          },
          "inp": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 120000"
          },
          "ttfb": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 120000"
          },
          "ts": {
            ".validate": "newData.val() == now"
          },
          "conn": {
            ".validate": "newData.isString() && newData.val().length <= 10"
          },
          "$otro": {
            ".validate": false
          }
        }
      }
    },
    "auditoria_productos": {
      ".read": true,
      ".write": false,
      "$auditId": {
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['accion','productoId','nombre','ts']) && newData.child('accion').isString() && newData.child('accion').val().length <= 20 && newData.child('productoId').isString() && newData.child('productoId').val().length <= 40 && newData.child('nombre').isString() && newData.child('nombre').val().length <= 80 && newData.child('ts').isNumber() && newData.child('ts').val() >= now - 300000 && newData.child('ts').val() <= now + 60000",
        "accion": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "productoId": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "nombre": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "ts": {
          ".validate": "newData.isNumber()"
        },
        "campo": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "de": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "a": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        }
      }
    },
    "avisos_stock": {
      "$productId": {
        "$tokenId": {
          ".write": true,
          ".validate": "newData.hasChildren(['token','ts']) && !newData.hasChild('tel')",
          "token": {
            ".validate": "newData.isString() && newData.val().length >= 4 && newData.val().length < 500"
          },
          "ts": {
            ".validate": "newData.isNumber()"
          },
          "producto": {
            ".validate": "newData.isString() && newData.val().length < 200"
          }
        }
      },
      ".read": "auth != null && auth.uid === root.child('admin_uid').val()",
      ".write": false
    },
    "agente": {
      ".read": false,
      ".write": false,
      "faq": {
        ".read": true,
        "$faqKey": {
          ".write": "newData.exists() && (!data.exists() || newData.child('count').val() === data.child('count').val() + 1)",
          ".validate": "newData.hasChildren(['query','intent','count','lastUpdated'])",
          "query": {
            ".validate": "newData.isString() && newData.val().length <= 300"
          },
          "intent": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "lastResponse": {
            ".validate": "newData.isString() && newData.val().length <= 300"
          },
          "count": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
          },
          "lastUpdated": {
            ".validate": "newData.isNumber()"
          }
        },
        ".write": false,
        ".indexOn": [
          "count"
        ]
      },
      "interacciones": {
        "$ts": {
          ".write": "!data.exists()",
          ".validate": "newData.hasChildren(['query','intent','ts']) && newData.child('query').isString() && newData.child('query').val().length <= 300 && newData.child('intent').isString() && newData.child('intent').val().length <= 40 && newData.child('ts').isNumber()",
          "fecha": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "productsShown": {
            ".validate": true
          }
        },
        ".read": true,
        ".write": false
      }
    },
    "wishlist_avisos": {
      "$productId": {
        "$tokenId": {
          ".write": "!data.exists() || !newData.exists()",
          ".validate": "newData.hasChildren(['token','ts'])",
          "token": {
            ".validate": "newData.isString() && newData.val().length >= 4 && newData.val().length < 500"
          },
          "ts": {
            ".validate": "newData.isNumber()"
          }
        }
      },
      ".read": "auth != null && auth.uid === root.child('admin_uid').val()",
      ".write": false
    },
    "resenas": {
      ".read": true,
      ".write": false,
      "$productoId": {
        "$resenaId": {
          ".write": "!data.exists()",
          ".validate": "newData.hasChildren(['autor','texto','estrellas','fecha','ts']) && newData.child('estrellas').isNumber() && newData.child('estrellas').val() >= 1 && newData.child('estrellas').val() <= 5 && newData.child('texto').val().length >= 10 && newData.child('texto').val().length <= 400 && newData.child('autor').val().length >= 1 && newData.child('autor').val().length <= 50 && newData.child('ts').isNumber() && newData.child('ts').val() >= now - 300000 && newData.child('ts').val() <= now + 60000"
        }
      }
    },
    "pedidos": {
      ".read": false,
      ".write": false,
      "$pedidoId": {
        ".read": true,
        ".write": "newData.exists() && !data.exists()",
        ".validate": "newData.hasChildren(['fecha','items','total','estado','actualizado']) && newData.child('fecha').isString() && newData.child('fecha').val().length <= 60 && newData.child('total').isNumber() && newData.child('total').val() >= 0 && newData.child('estado').isString() && newData.child('estado').val().length <= 20 && newData.child('actualizado').isNumber()",
        "id": {
          ".validate": "newData.isNumber() || newData.isString()"
        },
        "fecha": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "estado": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "total": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "actualizado": {
          ".validate": "newData.isNumber()"
        },
        "clienteTs": {
          ".validate": "newData.isNumber()"
        },
        "items": {
          "$idx": {
            "id": {
              ".validate": true
            },
            "nombre": {
              ".validate": "newData.isString() && newData.val().length <= 120"
            },
            "cantidad": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000"
            },
            "precio": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            }
          }
        }
      }
    },
    "ventas": {
      ".read": "auth != null && auth.uid === root.child('admin_uid').val()",
      ".write": false,
      "$ventaId": {
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['producto', 'precio', 'cantidad', 'total', 'fecha']) && newData.child('producto').isString() && newData.child('producto').val().length > 0 && newData.child('producto').val().length <= 200 && newData.child('precio').isNumber() && newData.child('precio').val() >= 0 && newData.child('cantidad').isNumber() && newData.child('cantidad').val() >= 0 && newData.child('total').isNumber() && newData.child('total').val() >= 0"
      }
    },
    "lista_espera": {
      ".read": false,
      ".write": false,
      "$productoId": {
        "$entradaId": {
          ".write": "!data.exists()",
          ".validate": "newData.hasChildren(['tel','productoId','ts']) && newData.child('tel').isString() && newData.child('tel').val().length >= 6 && newData.child('tel').val().length <= 25 && newData.child('ts').isNumber()"
        }
      }
    },
    "interesados": {
      ".read": true,
      ".write": false,
      "$productoId": {
        "$ts": {
          ".write": "!data.exists()",
          ".validate": "newData.hasChildren(['ts','producto','productoId']) && newData.child('ts').isNumber() && newData.child('ts').val() >= now - 300000 && newData.child('ts').val() <= now + 60000 && newData.child('producto').isString() && newData.child('producto').val().length <= 200"
        }
      }
    },
    "configuracion": {
      ".read": true,
      ".write": false,
      "categorias": {
        ".write": false
      },
      "version": {
        ".read": true,
        ".write": false
      }
    },
    "config": {
      ".read": false,
      ".write": false,
      "version": {
        ".read": true,
        ".write": "newData.exists() && (!data.exists() || newData.val() > data.val())",
        ".validate": "newData.isNumber() && newData.val() >= now - 300000 && newData.val() <= now + 300000"
      }
    },
    "admin_push_requests": {
      "$reqId": {
        ".write": "auth != null && auth.uid === root.child('admin_uid').val()",
        ".validate": "newData.hasChildren(['title','body','ts']) && newData.child('title').isString() && newData.child('title').val().length >= 1 && newData.child('title').val().length <= 100 && newData.child('body').isString() && newData.child('body').val().length >= 1 && newData.child('body').val().length <= 300 && newData.child('ts').isNumber()"
      },
      ".read": false,
      ".write": false
    },
    "admin_meta": {
      ".read": false,
      ".write": false,
      "pinHash": {
        ".write": "!data.exists()",
        ".validate": "newData.isString() && newData.val().length == 64"
      }
    },
    "admin_tokens": {
      "$tokenId": {
        ".write": "auth != null && auth.uid === root.child('admin_uid').val()",
        ".validate": "newData.hasChildren(['token','ts'])",
        "token": {
          ".validate": "newData.isString() && newData.val().length >= 4 && newData.val().length < 500"
        },
        "ts": {
          ".validate": "newData.isNumber()"
        },
        "label": {
          ".validate": "newData.isString() && newData.val().length < 80"
        }
      },
      ".read": false,
      ".write": false
    },
    "seguimientos": {
      "$ventaId": {
        ".write": "auth != null && auth.uid === root.child('admin_uid').val()",
        ".validate": "newData.hasChild('ts')",
        "ts": {
          ".validate": "newData.isNumber()"
        },
        "hecho": {
          ".validate": "newData.isString() && newData.val().length < 24"
        },
        "$otro": {
          ".validate": false
        }
      },
      ".read": "auth != null && auth.uid === root.child('admin_uid').val()",
      ".write": false
    },
    "notificaciones_estado": {
      ".read": false,
      ".write": false
    },
    "avisos_count": {
      "$productId": {
        "count": {
          ".read": true,
          ".write": "!data.exists() || newData.val() == data.val() + 1",
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
        }
      },
      ".read": true,
      ".write": false
    },
    "admin_auth": {
      ".read": false,
      ".write": "!data.exists() || newData.child('proof').val() == data.child('hash').val()",
      ".validate": "newData.hasChildren(['hash','salt','iterations','proof']) && newData.child('hash').isString() && newData.child('hash').val().length == 64 && newData.child('salt').isString() && newData.child('salt').val().length >= 20 && newData.child('iterations').isNumber() && newData.child('iterations').val() >= 100000 && newData.child('proof').isString() && newData.child('proof').val().length == 64 && newData.child('proof').val() !== newData.child('hash').val()",
      "hash": {
        ".validate": "newData.isString() && newData.val().length == 64"
      },
      "salt": {
        ".validate": "newData.isString() && newData.val().length >= 20"
      },
      "iterations": {
        ".validate": "newData.isNumber() && newData.val() >= 100000"
      },
      "proof": {
        ".validate": "newData.isString() && newData.val().length == 64"
      }
    },
    "privado": {
      ".read": "auth != null && auth.uid === root.child('admin_uid').val()",
      ".write": "auth != null && auth.uid === root.child('admin_uid').val()"
    },
    "admin_uid": {
      ".read": "auth != null",
      ".write": "!data.exists() && auth != null && newData.isString() && newData.val() === auth.uid"
    }
  }
}